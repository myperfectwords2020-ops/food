# Application
NODE_ENV=development
# Local browser: http://localhost:3000 — for Paystack webhooks/callbacks use HTTPS via ngrok (see npm run tunnel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TENANT_SLUG=elanskin-dev
LOG_LEVEL=info

# PostgreSQL (required in production)
# At 10k+ products / 100k+ users, use a pooled URL (Neon -pooler host) for the app.
# Keep a direct (non-pooler) URL for prisma migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elanskin?schema=public
# Optional: direct connection for migrations with poolers
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elanskin?schema=public

# Redis (required for BullMQ workers in production)
REDIS_URL=redis://localhost:6379

# Auth.js / NextAuth (required in production) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Paystack (Phase 5 — secret keys server-only; public key optional for inline checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=sk_test_d9a5e051e0a761b0752d39e5c546f9e98e908b89
# Optional label; webhook HMAC uses PAYSTACK_SECRET_KEY per Paystack docs
PAYSTACK_WEBHOOK_SECRET=

# AI provider (server-only)
AI_API_KEY=

# Notifications (server-only) — Resend email + Meta WhatsApp Cloud API
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_SECRET=

# S3-compatible object storage (server-only) — required for admin product image uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
# Public URL prefix for uploaded objects (defaults to https://{bucket}.s3.{region}.amazonaws.com)
STORAGE_PUBLIC_BASE_URL=
